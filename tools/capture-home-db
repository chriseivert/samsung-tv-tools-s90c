#!/usr/bin/env bash
# Capture Samsung Home database schemas and selected Edenview assemblies.
set -euo pipefail

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
  exec sudo -E "$0" "$@"
fi

repo=${SAMSUNG_TV_TOOLS_DIR:-/home/cseivert/samsung-tv-tools}
tv_host=${TV_HOST:-172.16.40.13}
callback_host=${TV_CALLBACK_HOST:-172.16.10.5}
capture_port=${TV_CAPTURE_PORT:-4445}
output_parent=${S90C_RESEARCH_DIR:-/home/cseivert/s90c-research}
output_owner=${SUDO_USER:-cseivert}

case "$callback_host" in
  *[!0-9A-Fa-f:.]*|'')
    printf 'capture-home-db: invalid TV_CALLBACK_HOST: %s\n' "$callback_host" >&2
    exit 2
    ;;
esac
case "$capture_port" in
  *[!0-9]*|'')
    printf 'capture-home-db: invalid TV_CAPTURE_PORT: %s\n' "$capture_port" >&2
    exit 2
    ;;
esac
if [ "$capture_port" -lt 1 ] || [ "$capture_port" -gt 65535 ]; then
  printf 'capture-home-db: TV_CAPTURE_PORT must be between 1 and 65535\n' >&2
  exit 2
fi

for command in nix nc python3 tar base64 sha256sum; do
  if ! command -v "$command" >/dev/null 2>&1; then
    printf 'capture-home-db: missing host command: %s\n' "$command" >&2
    exit 2
  fi
done

if [ ! -d "$repo" ]; then
  printf 'capture-home-db: repository not found: %s\n' "$repo" >&2
  exit 2
fi

cd "$repo"
export TV_HOST="$tv_host"
umask 077

capture_dir="$output_parent/home-db-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$capture_dir/resources"

tv() {
  nix --extra-experimental-features 'nix-command flakes' \
    run .#tv-access -- "$@"
}

printf '[1/4] Capturing database schemas...\n'
tv '
for DB in \
 /opt/usr/home/owner/apps_rw/com.samsung.tv.contentservicemanager/data/.preview.db \
 /opt/usr/home/owner/apps_rw/com.samsung.tv.contentservicemanager/data/.preview.db.sqlite \
 /opt/usr/home/owner/apps_rw/com.samsung.tv.home.media/data/coba.db \
 /opt/usr/home/owner/apps_rw/com.samsung.tv.home.media/shared/trusted/sqlite.db \
 /opt/usr/home/owner/apps_rw/com.samsung.tv.home.sidebar/data/coba.db \
 /opt/usr/home/owner/apps_rw/com.samsung.tv.home.sidebar/shared/trusted/sqlite.db
do
  printf "\n=== %s ===\n" "$DB"
  ls -ln "$DB" 2>&1 || continue
  printf "%s\n" "-- header --"
  od -An -tx1 -N16 "$DB" 2>&1 || true
  printf "%s\n" "-- sqlite objects --"
  sqlite3 -readonly "$DB" \
    "SELECT type,name,tbl_name,sql FROM sqlite_master ORDER BY type,name;" \
    2>&1 || true
done
' >"$capture_dir/01-database-schemas.txt" 2>&1

printf '[2/4] Receiving selected Edenview assemblies on %s:%s...\n' \
  "$callback_host" "$capture_port"
bundle="$capture_dir/edenview-resources.tar.gz"
listener_log="$capture_dir/transfer-listener.txt"
nc -lvnp "$capture_port" >"$bundle" 2>"$listener_log" &
listener_pid=$!

cleanup_listener() {
  kill "$listener_pid" 2>/dev/null || true
}
trap cleanup_listener EXIT INT TERM
sleep 1

remote_command="/usr/bin/bash -c 'exec 5<>/dev/tcp/$callback_host/$capture_port; /bin/tar -czf - -C /opt/usr/apps/com.samsung.tv.coba.edenview/shared/res ResourceEdenView.dll TextResourceEdenView.dll ViewPluginFullHomeTiles.dll ViewPluginPages.dll en-US/TextResourceEdenView.resources.dll >&5 2>/dev/null'"

if ! tv "$remote_command"; then
  printf 'capture-home-db: TV resource transfer command failed\n' >&2
  exit 1
fi

wait "$listener_pid"
trap - EXIT INT TERM

tar -xzf "$bundle" -C "$capture_dir/resources"
rm -f "$bundle"

printf '[3/4] Extracting ASCII and UTF-16 strings locally...\n'
python3 - "$capture_dir/resources" "$capture_dir/02-resource-string-hits.txt" <<'PY'
from pathlib import Path
import re
import sys

root = Path(sys.argv[1])
output = Path(sys.argv[2])
wanted = re.compile(
    rb"top.?pick|for.?you|recommend|promotion|preview|content.?tile|"
    rb"full.?home|rank|personal",
    re.IGNORECASE,
)
ascii_re = re.compile(rb"[\x20-\x7e]{4,}")
utf16_re = re.compile(rb"(?:[\x20-\x7e]\x00){4,}")

with output.open("w", encoding="utf-8") as stream:
    for path in sorted(root.rglob("*.dll")):
        stream.write(f"\n=== {path.relative_to(root)} ===\n")
        data = path.read_bytes()
        values = []
        for match in ascii_re.finditer(data):
            value = match.group()
            if wanted.search(value):
                values.append(value.decode("ascii", "replace"))
        for match in utf16_re.finditer(data):
            raw = match.group()
            compact = raw.replace(b"\x00", b"")
            if wanted.search(compact):
                values.append(raw.decode("utf-16le", "replace"))
        for value in dict.fromkeys(values):
            stream.write(value + "\n")
PY

find "$capture_dir/resources" -type f -name '*.dll' -print0 |
  sort -z |
  xargs -0 sha256sum >"$capture_dir/03-resource-hashes.txt"

printf '[4/4] Creating archive...\n'
archive="$capture_dir.tar.gz"
tar -C "$capture_dir" -czf "$archive" .

if id "$output_owner" >/dev/null 2>&1; then
  chown -R "$output_owner":"$output_owner" "$capture_dir" "$archive"
fi

printf '\nCapture complete:\n%s\n' "$archive"
printf 'Keep the DLLs private; upload the archive here, not to the public repository.\n'
